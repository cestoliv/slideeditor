# Required. The server refuses to start without it on a public bind.
# At least 12 characters.
SLIDE_STUDIO_PASSWORD=change-me-to-something-long

# Backups taken before any migration. 0 keeps every one.
SLIDE_STUDIO_BACKUP_KEEP=5

# The public URL Caddy serves this on, used for the links handed to agents.
SLIDE_STUDIO_PUBLIC_URL=https://slides.example.com
