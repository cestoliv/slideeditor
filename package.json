{
  "name": "slide-studio",
  "version": "1.0.0",
  "description": "Local editor and agent backend for TikTok and Instagram slideshow images",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cestoliv/slideeditor.git"
  },
  "bugs": {
    "url": "https://github.com/cestoliv/slideeditor/issues"
  },
  "type": "module",
  "bin": {
    "slide-studio": "bin/slide-studio.mjs"
  },
  "files": [
    "dist/",
    "bin/",
    "assets/TikTokSans.ttf",
    "assets/TikTokSans-OFL.txt",
    "assets/SpaceMono.ttf",
    "assets/SpaceMono-OFL.txt",
    "assets/Octicons-LICENSE.txt",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/server/dev.ts",
    "dev:web": "vite",
    "dev:all": "concurrently -n api,web -c blue,green \"npm:dev\" \"npm:dev:web\"",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.node.json",
    "build:web": "vite build",
    "prepare": "npm run build",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit && eslint . && prettier --check .",
    "check:dist": "node -e \"import('./dist/server/server/cli.js')\"",
    "test": "vitest run",
    "test:shared": "vitest run --project shared",
    "test:server": "vitest run --project server",
    "test:web": "vitest run --project web",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --project shared --project server --coverage",
    "start": "node bin/slide-studio.mjs",
    "start:lan": "node bin/slide-studio.mjs --host 0.0.0.0",
    "migrations:freeze": "tsx scripts/freeze-migrations.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/cestoliv/slideeditor#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.2.0"
  }
}
